FROM golang:alpine as build-stage

EXPOSE 8080

WORKDIR /app

COPY code/example-backend .

RUN CGO_ENABLED=0 GOOS=linux go build -o server && go test ./...

###################################################################

FROM scratch

WORKDIR /app

COPY --from=build-stage /app/server .

ENV REQUEST_ORIGIN=http://localhost:5001

USER 10001:10001

EXPOSE 8080

CMD ["./server"]

