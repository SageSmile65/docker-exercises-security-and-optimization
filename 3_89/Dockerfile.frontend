FROM node:16-alpine AS build-stage

WORKDIR /app

COPY code/example-frontend .

RUN adduser -D appuser && chown -R appuser .
USER appuser
RUN npm install && npm run build

################################

FROM node:16-alpine

WORKDIR ./app

COPY --from=build-stage /app/build/ ./build
RUN adduser -D appuser && chown -R appuser . && npm install -g serve
USER appuser	
EXPOSE 5001
CMD ["serve", "-s", "build", "-l", "5001"]
